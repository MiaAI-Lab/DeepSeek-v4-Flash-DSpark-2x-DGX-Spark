# ============================================================
# Verify the build
# ============================================================
RUN python3 <<'PY'
import sys, torch
from typing import get_args

print("=== Verification ===")

# 1. Check nvfp4_ds_mla is in CacheDType
from vllm.config.cache import CacheDType
dtypes = get_args(CacheDType)
assert "nvfp4_ds_mla" in dtypes, f"MISSING: nvfp4_ds_mla in CacheDType"
print(f"[OK] nvfp4_ds_mla in CacheDType")

# 2. Check kv_quant_mode mapping
from vllm.v1.kv_cache_interface import get_kv_quant_mode
mode = get_kv_quant_mode("nvfp4_ds_mla")
assert mode.is_nvfp4, "nvfp4_ds_mla should map to KVQuantMode.NVFP4"
print(f"[OK] nvfp4_ds_mla -> KVQuantMode.NVFP4")

# 3. Check torch_utils dtype mapping
from vllm.utils.torch_utils import STR_DTYPE_TO_TORCH_DTYPE
assert "nvfp4_ds_mla" in STR_DTYPE_TO_TORCH_DTYPE
assert STR_DTYPE_TO_TORCH_DTYPE["nvfp4_ds_mla"] == torch.uint8
print(f"[OK] nvfp4_ds_mla -> torch.uint8 in STR_DTYPE_TO_TORCH_DTYPE")

# 4. Check MLAAttentionSpec page size for nvfp4_ds_mla
from vllm.v1.kv_cache_interface import MLAAttentionSpec, KVQuantMode
spec = MLAAttentionSpec(
    block_size=256,
    num_kv_heads=1,
    head_size=512,
    dtype=torch.uint8,
    compress_ratio=2,
    cache_dtype_str="nvfp4_ds_mla",
    model_version="deepseek_v4",
)
assert spec.real_page_size_bytes == 256 * 352, f"Expected {256 * 352}, got {spec.real_page_size_bytes}"
print(f"[OK] MLAAttentionSpec real_page_size_bytes={spec.real_page_size_bytes} (352 B/token)")

# 5. Check sparse_mla KV cache shape
from vllm.models.deepseek_v4.sparse_mla import DeepseekV4FlashMLABackend
shape = DeepseekV4FlashMLABackend.get_kv_cache_shape(3, 256, 1, 512, "nvfp4_ds_mla")
assert shape == (3, 256, 352), f"Unexpected shape: {shape}"
print(f"[OK] DeepseekV4FlashMLABackend shape for nvfp4_ds_mla: {shape}")

# 5b. Check supported_kv_cache_dtypes includes nvfp4_ds_mla (Issue #22 fix)
assert "nvfp4_ds_mla" in DeepseekV4FlashMLABackend.supported_kv_cache_dtypes, \
    "nvfp4_ds_mla missing from supported_kv_cache_dtypes"
print(f"[OK] nvfp4_ds_mla in DeepseekV4FlashMLABackend.supported_kv_cache_dtypes")

# 6. Check _resolve_dsv4_kv_cache_dtype handles nvfp4
from vllm.models.deepseek_v4.attention import _resolve_dsv4_kv_cache_dtype
from types import SimpleNamespace
cfg = SimpleNamespace(cache_dtype="nvfp4")
dtype_str, torch_dtype = _resolve_dsv4_kv_cache_dtype(True, "nvfp4", cfg)
assert dtype_str == "nvfp4_ds_mla", f"Expected nvfp4_ds_mla, got {dtype_str}"
assert cfg.cache_dtype == "nvfp4_ds_mla", f"Expected cache_config.dtype = nvfp4_ds_mla, got {cfg.cache_dtype}"
print(f"[OK] _resolve_dsv4_kv_cache_dtype('nvfp4') -> '{dtype_str}'")

# 7. Check DSpark proposer exists
from vllm.v1.spec_decode.dspark_proposer import DSparkProposer
print(f"[OK] DSparkProposer imported")

# 8. Check b12x modules
from vllm.v1.attention.backends.mla.b12x_mla_sparse import B12xMLASparseBackend
print(f"[OK] B12xMLASparseBackend imported")

print("\n=== All checks passed! ===")
PY

