{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanitized Qwen retirement manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at", "container", "model", "filesystem_targets"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "container": {
      "type": "object",
      "required": ["name", "container_id", "image_id", "project", "service", "config_hash", "restart_policy"]
    },
    "model": {"type": "object", "required": ["id", "revision", "served_names"]},
    "filesystem_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "path", "realpath", "exists"]
      }
    }
  },
  "additionalProperties": true
}
