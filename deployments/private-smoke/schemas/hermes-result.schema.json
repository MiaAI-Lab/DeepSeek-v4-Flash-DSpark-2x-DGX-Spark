{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plexiz.invalid/schemas/hermes-result.schema.json",
  "title": "Isolated Hermes smoke result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "accepted",
    "provider",
    "model",
    "tasks",
    "negative_checks",
    "shared_state",
    "usage",
    "request_ids"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9-]{8,80}$"},
    "accepted": {"type": "boolean"},
    "provider": {"const": "custom:deepseek-smoke"},
    "model": {"const": "deepseek-v4-flash-0731-smoke"},
    "tasks": {
      "type": "object",
      "required": ["create", "read", "transform"],
      "additionalProperties": false,
      "properties": {
        "create": {"const": true},
        "read": {"const": true},
        "transform": {"const": true}
      }
    },
    "negative_checks": {
      "type": "object",
      "required": ["skills", "mcp", "memory", "gateway", "host_paths", "network", "fallback"],
      "additionalProperties": {"type": "boolean"},
      "properties": {
        "skills": {"const": true},
        "mcp": {"const": true},
        "memory": {"const": true},
        "gateway": {"const": true},
        "host_paths": {"const": true},
        "network": {"const": true},
        "fallback": {"const": true}
      }
    },
    "shared_state": {
      "type": "object",
      "required": ["before_sha256", "after_sha256", "unchanged"],
      "additionalProperties": false,
      "properties": {
        "before_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "after_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "unchanged": {"const": true}
      }
    },
    "usage": {
      "type": "object",
      "required": ["api_calls", "completed", "failed", "input_tokens", "output_tokens", "total_tokens"],
      "additionalProperties": true,
      "properties": {
        "api_calls": {"type": "integer", "minimum": 1},
        "completed": {"const": true},
        "failed": {"const": false},
        "input_tokens": {"type": "integer", "minimum": 1},
        "output_tokens": {"type": "integer", "minimum": 1},
        "total_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "request_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^hermes-smoke-[a-f0-9-]{8,64}$"}
    }
  }
}
