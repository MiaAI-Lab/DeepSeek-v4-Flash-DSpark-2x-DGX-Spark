# DeepSeek V4 Flash DSpark C12 NVFP4 profile for 2x DGX Spark TP=2.
# Copy to .env.dspark on each node and adjust node-specific values.
#
# Env matrix (Anemll 0.1.1 vs Stage-C overlay): see docs/ENVS.md
# Default image is Anemll — keep Stage-C-only VLLM_* keys commented unless
# you build/run the Stage-C image and merge docker-compose.stage-c.override.yml.

# Cluster
WORKER_HOST=worker-host-or-roce-ip
# Worker-local checkout/deployment path. Leave blank to mirror the head path.
WORKER_DIR=
# Optional explicit worker checkout path. This is useful when the worker clone
# lives somewhere different from the head checkout; it takes precedence over
# WORKER_DIR when set.
WORKER_SCRIPT_DIR=
MASTER_ADDR=head-roce-ip
MASTER_PORT=25000
NODE_RANK=0
HEADLESS=

# Worker node should use:
# NODE_RANK=1
# HEADLESS=1

# RoCE / InfiniBand (head node). On a QSFP ring, the worker's facing port
# name often differs — set WORKER_NCCL_* below; start-*.sh passes them remotely.
NCCL_IB_HCA=rocepXsYfZ
NCCL_SOCKET_IFNAME=enpXsYfZnpN
TP_SOCKET_IFNAME=enp1s0f1np1
GLOO_SOCKET_IFNAME=enp1s0f1np1
# Optional worker overrides (defaults to the head values if unset).
# Set these on the HEAD .env; start-deepseek-v4-flash-dspark.sh injects them on
# remote compose (shared/scp'd .env is fine). Do not rely on WORKER_* first in
# docker-compose — that substitution is not rank-aware.
# WORKER_NCCL_IB_HCA=rocep1s0f0
# WORKER_NCCL_SOCKET_IFNAME=enp1s0f0np0
# WORKER_TP_SOCKET_IFNAME=enp1s0f0np0
# WORKER_GLOO_SOCKET_IFNAME=enp1s0f0np0
# RoCEv2 GID index: start-*.sh resolves per node from sysfs by default
# (NCCL_IB_GID_AUTO=1). Index differs per node/HCA and drifts after reboot;
# a single shared literal on both ranks can wedge NCCL at init.
# Pin only when you disable auto:
# NCCL_IB_GID_AUTO=0
# NCCL_IB_GID_INDEX=3
# WORKER_NCCL_IB_GID_INDEX=6
# Optional match IPs if the RoCE address is not the ifname primary IPv4:
# NCCL_IB_GID_MATCH_IP=10.0.22.1
# WORKER_NCCL_IB_GID_MATCH_IP=10.0.22.2
NCCL_CROSS_NIC=1

# Caches / model
HF_CACHE=${HOME}/.cache/huggingface
# Optional worker-local Hugging Face cache. Use this when the worker user/path
# differs from the head node. If blank, the worker uses HF_CACHE.
WORKER_HF_CACHE=
# Prefer offline when both nodes already have a full hub cache (online re-download can fill worker disks).
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1
DSPARK_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
DSPARK_MODEL_REVISION=9e165c30e2704aec5d9d593cce3eebd58bbef1cb
DSPARK_ENCODING_FILE=
SERVED_MODEL_NAME=deepseek-v4-flash-0731
# vLLM itself remains unauthenticated on head loopback. The separate origin
# auth proxy reads this mode-0600 file and exposes the bridge-only port.
VLLM_HOST=127.0.0.1
VLLM_PORT=8889
VLLM_ORIGIN_KEY_FILE=${HOME}/.config/dspark-smoke/origin.key
VLLM_PROXY_HOST=172.30.0.1
VLLM_PROXY_PORT=8888
# Near-1M-token prefill can legitimately exceed the generic proxy's 900s default.
VLLM_PROXY_UPSTREAM_TIMEOUT=3600
# Explicit per-node host IPs prevent distributed vLLM/ZeroMQ from binding the
# worker to the head node's fabric address. Set these to each node's RoCE IP.
VLLM_HOST_IP=head-roce-ip
WORKER_VLLM_HOST_IP=worker-roce-ip

# Prebuilt Anemll DSpark vLLM GX10 image (https://github.com/Anemll/dspark-vllm-gx10).
# Pull: docker pull ghcr.io/anemll/dspark-vllm-gx10:0.1.1
# Alternative: build locally with ./build-dspark-vllm-runtime.sh → vllm-dspark-runtime:dspark-nvfp4-stage-c
# and merge docker-compose.stage-c.override.yml (see docs/ENVS.md).
DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10@sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8

# Deterministic GB10 serving profile. The default reserves exactly 12 GiB of
# KV cache per rank. MEMORY_CONTROL is also the pinned vLLM flag name so the
# rendered command contains exactly one memory control.
MEMORY_CONTROL=kv-cache-memory-bytes
KV_CACHE_MEMORY_BYTES=12884901888
# Pinned vLLM still evaluates this as a startup admission/headroom guard before
# the explicit byte value takes over KV sizing; it is not the KV sizing control.
GPU_MEMORY_UTILIZATION=0.80
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
# 8192 target tokens plus 24 scheduler slots for MTP-5 at six-way concurrency.
MAX_NUM_BATCHED_TOKENS=8216
# The pinned runtime auto-generates capture rows through its effective 32-row ceiling.
MAX_CUDAGRAPH_CAPTURE_SIZE=32
MTP_NUM_TOKENS=5
# 0 keeps regular CUDA graphs enabled. Set 1 only for an explicit eager rollback.
ENFORCE_EAGER=0
# Default reasoning mode: off, low, high, or max. "max" enables full
# thinking/reasoning effort by default; request-level overrides still win.
DEFAULT_THINKING=low

# No sampling override. The launcher keeps --generation-config vllm only.
# Explicit client request parameters still win.

# Higher-throughput short-context profile from the Keys concurrency patch:
# MAX_MODEL_LEN=200000
# MAX_NUM_SEQS=16
#
# Explicit compatibility/rollback memory profile (never set both values):
# MEMORY_CONTROL=gpu-memory-utilization
# KV_CACHE_MEMORY_BYTES=
# GPU_MEMORY_UTILIZATION=0.80
#
# Context and concurrency share one KV pool. The conservative 1M-token lane
# keeps 6 active sequence slots for long-context agent traffic.
# Normal agent turns are much shorter than the maximum; multiple simultaneous
# full-context requests may still queue depending on the live KV pool.

# ---------------------------------------------------------------------------
# Anemll 0.1.1-safe vLLM / runtime knobs (default compose injects these)
# ---------------------------------------------------------------------------
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_USE_B12X_MOE=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
VLLM_B12X_W4A16_FORCE_TILE_CONFIG=

VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0

# CuTeDSL / b12x compile target for GB10 (not a VLLM_* registry key).
CUTE_DSL_ARCH=sm_121a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
TILELANG_CLEANUP_TEMP_FILES=1
DG_JIT_USE_NVRTC=0
DG_JIT_NVCC_COMPILER=/usr/local/cuda/bin/nvcc
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN
NCCL_NVLS_ENABLE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# ---------------------------------------------------------------------------
# Stage-C overlay only — DO NOT enable on Anemll 0.1.1
# Uncomment when DSPARK_VLLM_IMAGE is the Stage-C build AND you merge
# docker-compose.stage-c.override.yml. On Anemll these VLLM_* keys warn:
#   "Unknown vLLM environment variable detected: …"
# and are ignored. Full matrix: docs/ENVS.md
# ---------------------------------------------------------------------------
# VLLM_USE_B12X_WO_PROJECTION=1
# VLLM_DSPARK_CONFIDENCE_THRESHOLD=0.0
# VLLM_DSPARK_CONFIDENCE_SCHEDULER=off
# VLLM_DSPARK_LOCAL_ARGMAX=1
# VLLM_DSPARK_REPLICATE_MARKOV_W1=1
# VLLM_DSPARK_FUSED_MARKOV_ARGMAX=0
# VLLM_DSPARK_GPU_REJECTED_CONTEXT_MASK=1
# VLLM_DSPARK_REFERENCE_KV_QUANT_DEQUANT=0
# DSPARK_SLOT_CLAMP=1
# VLLM_DSPARK_HARDWARE_SCHEDULER_EARLY_STOP=1
# B12X_W4A16_TC_DECODE=0
# VLLM_DSV4_B12X_COMPRESSED_MLA=0
# VLLM_DSV4_DSPARK_DEFER_TARGET_CAPTURE=0
# VLLM_DSV4_DSPARK_DEFER_TARGET_CAPTURE_EXACT=0
# VLLM_TRITON_MLA_SPARSE=1
# VLLM_SKIP_INIT_MEMORY_CHECK=1

# ---------------------------------------------------------------------------
# Vision mode flag (one switch) + VL sidecar + MCP harness install
# ---------------------------------------------------------------------------
# ENABLE_VL_SIDECAR=1 → start Qwen3-VL TP=2 on :8889 + MCP install, and set
#   0731 util from GPU_MEMORY_UTILIZATION_VISION (default 0.80).
# ENABLE_VL_SIDECAR=0 → text-only 0731, util from GPU_MEMORY_UTILIZATION_TEXT
#   (default 0.835) for a larger KV pool.
# Flip the flag, then ./stop-… && ./start-… (full restart required).
#
# Measured Available KV (this cluster, Anemll 0.1.1, 2026-08-11):
#   text (flag=0, util 0.835): main ~18.08 GiB / ~2.49M tokens
#   vision (flag=1, util 0.80 + VL 0.04): main 13.37 GiB / 1.37M + VL 1.54 GiB / 84k
# Default: off (text-only, larger main KV). Vision/VL coexist is deferred to a
# follow-up PR — leave knobs commented; they are unused while the flag is 0.
ENABLE_VL_SIDECAR=0
# Do not download VL weights on text-only prepare (set 1 only for a vision PR).
PREPARE_VL_SIDECAR_MODEL=0
# VL_SIDECAR_MODEL=cyankiwi/Qwen3-VL-4B-Instruct-AWQ-4bit
# VL_SIDECAR_SERVED_NAME=qwen3-vl-4b
# VL_SIDECAR_PORT=8889
# VL_SIDECAR_TP_SIZE=2
# VL_SIDECAR_NNODES=2
# VL_SIDECAR_MASTER_PORT=25100
# VL_SIDECAR_GPU_UTIL=0.04
# VL_SIDECAR_MAX_NUM_SEQS=4
# VL_SIDECAR_MAX_MODEL_LEN=32768
# VL_SIDECAR_KV_CACHE_DTYPE=int4_per_token_head
# VL_SIDECAR_ATTENTION_BACKEND=TRITON_ATTN
# Optional: VL_SIDECAR_KV_CACHE_MEMORY_BYTES=367001600
# VL weights: ./prepare-dspark-model-cache.sh downloads VL_SIDECAR_MODEL on
# head and worker when PREPARE_VL_SIDECAR_MODEL=1 (TP=2 needs both caches).
# After sidecar is healthy, start can register MCP into detected harnesses
# only when ENABLE_VL_SIDECAR=1 (installer also no-ops if the flag is off).
# INSTALL_VISION_MCP=0 skips harness registration even when vision is on.
# INSTALL_VISION_MCP=1
# VISION_MCP_HARNESSES=auto
# VISION_MCP_HARNESSES=pi,omp,hermes,opencode,goose,grok,openclaw,zcode,prime,factory,commandcode
