# DeepSeek V4 Flash DSpark NVFP4 profile for 2x DGX Spark TP=2.
# Copy to .env.dspark on each node and adjust node-specific values.

# Cluster
WORKER_HOST=worker-host-or-roce-ip
MASTER_ADDR=head-roce-ip
MASTER_PORT=25000

# RoCE / InfiniBand
HEAD_IB_HCA=head-roce-device
WORKER_IB_HCA=worker-roce-device
HEAD_ETH_IF=head-socket-interface
WORKER_ETH_IF=worker-socket-interface
NCCL_IB_GID_INDEX=0
NCCL_CROSS_NIC=1

# Caches / model
HF_CACHE=${HOME}/.cache/huggingface
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
HF_HUB_DISABLE_XET=1
DSPARK_MODEL_DIR=/absolute/path/to/DeepSeek-V4-Flash-DSpark
# Create this marker in the exact downloaded snapshot before mounting it read-only:
# printf '%s\n' 913f0657a874f76844e2e91cbe706dbcaceeb6d7 > "$DSPARK_MODEL_DIR/.r0b0tlab-model-revision"
# Optional when the host-side model paths differ; both are mounted as /model.
# DSPARK_HEAD_MODEL_DIR=/read-only/shared/or/local/head/path
# DSPARK_WORKER_MODEL_DIR=/local/worker/path
SERVED_MODEL_NAME=deepseek-v4-flash-dspark
VLLM_HOST=0.0.0.0

# Production wrapper built from recipe/Dockerfile.production.
DSPARK_VLLM_IMAGE=dspark-r0b0tlab:production-candidate
KV_CACHE_DTYPE=nvfp4_ds_mla

# Throughput profile; the 1M profile remains in profiles/dspark-r0b0tlab-1m.env.
MAX_MODEL_LEN=200000
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=16384
GPU_MEMORY_UTILIZATION=0.84
MTP_NUM_TOKENS=5

# Balanced deep-context fallback:
# MAX_MODEL_LEN=500000
# MAX_NUM_SEQS=4

# DSpark-r0b0tlab 1M profile details:
# See profiles/dspark-r0b0tlab-1m.env and docs/DSPARK_R0B0TLAB_1M.md.

# DSpark-r0b0tlab 384K publication candidate:
# MAX_MODEL_LEN=384000
# MAX_NUM_SEQS=4
# GPU_MEMORY_UTILIZATION=0.88
# See profiles/dspark-r0b0tlab-384k.env and docs/DSPARK_R0B0TLAB_384K.md.

# Validated Keys concurrency benchmark profile:
# MAX_MODEL_LEN=200000
# MAX_NUM_SEQS=16


# Native vLLM 0.25 / FlashInfer switches used by the production image.
# Legacy Stage-C-only DSpark knobs are intentionally not exported here: vLLM
# 0.25 rejects them as unknown and the native speculator owns those policies.
VLLM_USE_B12X_MOE=1
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
VLLM_B12X_W4A16_FORCE_TILE_CONFIG=
B12X_W4A16_TC_DECODE=0

# Runtime defaults.
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
TILELANG_CLEANUP_TEMP_FILES=1
DG_JIT_USE_NVRTC=0
DG_JIT_NVCC_COMPILER=/usr/local/cuda/bin/nvcc
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN
NCCL_NVLS_ENABLE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
